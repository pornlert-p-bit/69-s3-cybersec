# REST

@adminEmail = {{$dotenv ADMIN_EMAIL}}
@adminPassword = {{$dotenv ADMIN_PASSWORD}}
@adminFirstname = {{$dotenv ADMIN_FIRSTNAME}}
@adminLastname = {{$dotenv ADMIN_LASTNAME}}
@userUsername = {{$dotenv USER_USERNAME}}
@userEmail = {{$dotenv USER_EMAIL}}
@userPassword = {{$dotenv USER_PASSWORD}}

## 1. Admin Section
### 1.1 Login
# @name loginAdmin
POST http://localhost:9093/admin/login
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}",
    "rememberMe": true
}

### 1.2 Signup
POST http://localhost:9093/admin/register-admin
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "firstname": "{{adminFirstname}}",
    "lastname": "{{adminLastname}}",
    "password": "{{adminPassword}}"
}

### 1.3 Forgot Password
POST http://localhost:9093/admin/forgot-password
Content-Type: application/json

{
    "email": "{{adminEmail}}"
}

### 1.3.1 Reset Password
POST http://localhost:9093/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "",
    "password": "{{adminPassword}}"
}

### 1.4 Profile
GET http://localhost:9093/admin/users/me
Authorization: Bearer {{loginAdmin.response.body.data.token}}


## 2. User Section
### 2.1 Login
# @name loginUser
POST http://localhost:9093/api/auth/local
Content-Type: application/json

{
    "identifier": "{{userEmail}}",
    "password": "{{userPassword}}"
}

### 2.2 Signup
POST http://localhost:9093/api/auth/local/register
Content-Type: application/json

{
    "username": "{{userUsername}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
}

### 2.3 Forgot Password
POST http://localhost:9093/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{userEmail}}"
}

### 2.3.1 Reset Password
POST http://localhost:9093/api/auth/reset-password
Content-Type: application/json

{
    "code": "",
    "password": "{{userPassword}}",
    "passwordConfirmation": "{{userPassword}}"
}

### 2.4 Profile
GET http://localhost:9093/api/users/me
Authorization: Bearer {{loginUser.response.body.jwt}}
